# ============ BOT DISCORD ============
BOT_TOKEN=TOKEN_BOT_DISCORD_KAMU
CLIENT_ID=CLIENT_ID_APLIKASI_DISCORD
GUILD_ID=ID_SERVER_DISCORD_KAMU

# Role yang boleh pakai command admin (pisahkan dengan koma jika lebih dari satu)
OWNER_IDS=123456789012345678
ADMIN_ROLE_IDS=

# ============ PTERODACTYL PANEL ============
# Contoh: https://panel.domainkamu.com (tanpa / di akhir)
PTERO_URL=https://panel.domainkamu.com
# Application API Key (dibuat di Panel -> Admin -> Application API)
PTERO_APP_KEY=ptla_xxxxxxxxxxxxxxxxxxxxx

# ID default di panel kamu (cek di admin panel)
PTERO_EGG_ID=15
PTERO_NEST_ID=5
PTERO_LOCATION_ID=1

# Docker image & startup default (untuk egg NodeJS)
PTERO_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:nodejs_21
PTERO_STARTUP=if [[ -d .git ]] && [[ {{AUTO_UPDATE}} == "1" ]]; then git pull; fi; if [[ ! -z ${NODE_PACKAGES} ]]; then /usr/local/bin/npm install ${NODE_PACKAGES}; fi; if [[ ! -z ${UNNODE_PACKAGES} ]]; then /usr/local/bin/npm uninstall ${UNNODE_PACKAGES}; fi; if [ -f /home/container/package.json ]; then /usr/local/bin/npm install; fi; /usr/local/bin/${CMD_RUN}

# ============ WEBSITE ============
WEB_PORT=3000
# Password login halaman admin website
WEB_ADMIN_PASSWORD=admin123
